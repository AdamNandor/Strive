<Window x:Class="WpfApp1.Windows.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.Windows"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Bejelentkezés" Height="450" Width="800"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="#101311"
        FontFamily="{materialDesign:MaterialDesignFont}">
    <Grid>
        <StackPanel>
            <StackPanel Orientation="Horizontal"
                        Margin="0,50,0,0"
                        HorizontalAlignment="Center">
                <Label Content="strive" 
                       HorizontalAlignment="Center"
                       FontSize="50"
                       FontWeight="Bold"/>
                <Label Content="."
                       HorizontalAlignment="Center"
                       FontSize="50"
                       FontWeight="Bold"
                       Margin="-10,0,0,0"
                       Foreground="GreenYellow"/>
            </StackPanel>
            <Border Margin="5,30,5,5"
                    HorizontalAlignment="Center" 
                    BorderBrush="Black" 
                    BorderThickness="1" 
                    Height="230" 
                    Width="300"
                    CornerRadius="20"
                    Padding="15"
                    Background="#252924">

                <StackPanel>

                    <Label Content="Bejelentkezés"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"
                       FontSize="20"
                       FontWeight="Bold"/>

                    <Grid Margin="0,0,0,20">
                        <TextBlock x:Name="tblFelhasznalonev"
                           Text="Felhasználónév"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0" />

                        <TextBox x:Name="tbxFelhasznalonev"
                             Width="125"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             Margin="0,0,10,0"/>
                    </Grid>

                    <Grid Margin="0,0,0,15">
                        <TextBlock x:Name="tblJelszo"
                           Text="Jelszó"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0" />

                        <PasswordBox x:Name="pwbJelszo"
                             Width="125"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             Margin="0,0,10,0"/>
                    </Grid>
                    
                    <Grid>
                        <TextBlock x:Name="HibasText"
                                   HorizontalAlignment="Center"
                                   Foreground="Red"
                                   />
                    </Grid>

                    <Button x:Name="btnBejelentkezes"
                            HorizontalAlignment="Center"
                            Margin="15"
                            Width="100"
                            Height="30"
                            Content="Bejelentkezés"
                            FontSize="11"
                            Click="btnBejelentkezes_Click"
                            />

                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</Window>
