<Window x:Class="Strive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Strive"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Adminisztrációs menü" Height="450" Width="800"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="#101311"
        FontFamily="{materialDesign:MaterialDesignFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="7*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.ColumnSpan="2"
                CornerRadius="5"
                Background="DimGray"
                Margin="10,10,10,0"
                VerticalAlignment="Top">

            <Label Content="Adminisztrációs felület"
                   FontSize="18"
                   FontWeight="Bold"
                   Background="#252924"/>
        </Border>

        <StackPanel Margin="5,40,0,0"
                    Orientation="Horizontal">
            <Label Content="Keresés:"
                   Margin="5,0,0,0"
                   Height="20"
                   FontWeight="Bold"
                   FontSize="12"
                   HorizontalContentAlignment="Left"
                   VerticalContentAlignment="Top"/>
            <TextBox Name="tbxKereses"
                     VerticalContentAlignment="Center"
                     Width="300"
                     Height="20"
                     Margin="5,0,0,0"/>

        </StackPanel>
        <Border Grid.Row="1"
                Margin="10,0,5,10"
                CornerRadius="8"
                Background="#252924">
            <StackPanel >
                <Label Content="FELHASZNÁLÓK"
                       Margin="5"
                       FontSize="15"/>
                <ListBox Name="lbxFelhasznalok"
                         Margin="5,5,5,5"
                         Height="280"
                         />
            </StackPanel>
        </Border>
    </Grid>
</Window>
