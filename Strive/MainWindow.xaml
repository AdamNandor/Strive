<Window x:Class="Strive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Strive"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Adminisztrációs menü" Height="450" Width="800"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="#101311"
        FontFamily="{materialDesign:MaterialDesignFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="7*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.ColumnSpan="2"
                CornerRadius="6"
                Background="#252924"
                Margin="10,10,10,0"
                VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left">
                <Label Content="strive" 
                       Margin="10,5,5,5"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       FontSize="18"
                       FontWeight="Bold"/>
                <Label Content="."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="-10,0,0,0"
                       Foreground="GreenYellow"/>
                <Label Content="|"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       FontSize="25"/>
                <Label Content="Adminisztrációs felület"
                       VerticalAlignment="Center"
                       Margin="5"
                       FontSize="18"
                       FontWeight="Bold"/>
            </StackPanel>

        </Border>

        <StackPanel Margin="5,40,0,0"
                    Orientation="Horizontal">
            <Label Content="Keresés:"
                   Margin="10,5,0,0"
                   Height="20"
                   FontWeight="Bold"
                   FontSize="12"
                   HorizontalContentAlignment="Left"
                   VerticalContentAlignment="Top"/>
            <TextBox Name="tbxKereses"
                     VerticalContentAlignment="Center"
                     Width="300"
                     Height="20"
                     Margin="5,0,0,0"/>

        </StackPanel>
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
        <Button x:Name="btnUjFelhasznalo"
                Content="+ Új felhasználó"
                Height="28"
                VerticalAlignment="Bottom"
                Margin="0,0,15,10"
                Click="btnUjFelhasznalo_Click"/>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="10,0,15,10"
                CornerRadius="8"
                Background="#252924">
            <StackPanel >
                <Label Content="FELHASZNÁLÓK"
                       Margin="5"
                       FontSize="15"/>
                <ListBox Name="lbxFelhasznalok"
                         Margin="5,5,5,5"
                         Height="280"
                         SelectionChanged="lbxFelhasznalok_SelectionChanged"
                         />
            </StackPanel>
        </Border>
        <Border Grid.Row="1"
                Grid.Column="1"
                Margin="10,0,10,10"
                CornerRadius="8"
                Background="#252924">
            <Grid>
                <!--1. Felhasználók módosítására szánt panel-->
                <StackPanel Name="spAdatok" Visibility="Visible" >
                    <Label Name="lblAdatok"
                           Content="ADATOK"
                           Margin="5,5,5,10"
                           FontSize="15"/>

                    <Label Content="Név:"
                               Margin="20,5,20,0"/>
                    <TextBox Name="tbxNev"
                                 VerticalAlignment="Center"
                                 Height="25"
                                 Margin="40,0,40,20"/>

                    <Label Content="Email:"
                               Margin="20,5,20,0"/>
                    <TextBox Name="tbxEmail"
                                 VerticalAlignment="Center"
                                 Height="25"
                                 Margin="40,0,40,20"/>

                    <Label Content="Role:"
                               Margin="20,5,10,0"/>
                    <ComboBox Name="cbxRole"
                                  VerticalAlignment="Center"
                                  Height="25"
                                  Margin="40,0,40,20">
                        <ComboBoxItem Content="member"/>
                        <ComboBoxItem Content="admin"/>
                        <ComboBoxItem Content="trainer"/>
                    </ComboBox>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="10,5,10,0">
                        <Button x:Name="btnMentes"
                                Content="Mentés"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="0,0,10,0"
                                Height="30"
                                Width="100"
                                Click="btnMentes_Click"/>

                        <Button x:Name="btnTorles"
                                Content="Törlés"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="10,0,0,0"
                                Height="30"
                                Width="100"
                                Background="Red"
                                Foreground="White"
                                Click="btnTorles_Click"/>
                    </StackPanel>
                </StackPanel>
                <!--2. Új felhasználók létrehozására való panel-->
                <StackPanel Name="spUjFelhasznalo" Visibility="Collapsed">
                    <Label Name="lblUjAdatok"
                           Content="ÚJ FELHASZNÁLÓ LÉTREHOZÁSA"
                           Margin="5,5,5,10"
                           FontSize="15"/>

                    <Label Content="Név:"
                           Margin="20,5,20,0"/>
                    <TextBox Name="tbxUjNev"
                             VerticalAlignment="Center"
                             Height="25"
                             Margin="40,0,40,5"/>

                    <Label Content="Jelszó:"
                           Margin="20,5,20,0"/>
                    <PasswordBox Name="pwbUjJelszo"
                             VerticalAlignment="Center"
                             Height="25"
                             Margin="40,0,40,5"/>

                    <Label Content="Email:"
                           Margin="20,0,20,0"/>
                    <TextBox Name="tbxUjEmail"
                             VerticalAlignment="Center"
                             Height="25"
                             Margin="40,0,40,5"/>

                    <Label Content="Role:"
                           Margin="20,0,10,0"/>
                    <ComboBox Name="cbxUjRole"
                              VerticalAlignment="Center"
                              Height="25"
                              Margin="40,0,40,5">
                        <ComboBoxItem Content="member"/>
                        <ComboBoxItem Content="admin"/>
                        <ComboBoxItem Content="trainer"/>
                    </ComboBox>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="10,10,10,0">
                        <Button x:Name="btnLetrehozas"
                                Content="Létrehozás"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="0,0,10,0"
                                Height="30"
                                Width="100"
                                Click="btnLetrehozas_Click"/>

                        <Button x:Name="btnMegsem"
                                Content="Mégsem"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="10,0,0,0"
                                Height="30"
                                Width="100"
                                Background="Red"
                                Foreground="White"
                                Click="btnMegsem_Click"/>
                    </StackPanel>
                </StackPanel>
           </Grid>

        </Border>
    </Grid>
</Window>
